
@model CarWashSystem.ViewModels.RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Реєстрація";
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Реєстрація — Чисто</title>

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />

    <script>
        document.documentElement.dataset.theme =
            localStorage.getItem("carwash-theme") === "dark"
                ? "dark"
                : "light";
    </script>
</head>

<body>
    <main class="auth-page">

        <!-- ЛІВА ПАНЕЛЬ -->
        <section class="welcome-panel">

            <!-- Логотип -->
            <a class="logo"
               asp-controller="Account"
               asp-action="Login">

                <span class="logo-icon">
                    <svg viewBox="0 0 32 40"
                         aria-hidden="true">

                        <path d="M16 2C12 9 4 18 4 25a12 12 0 0 0 24 0C28 18 20 9 16 2Z" />

                        <path d="M11 27c0 3 2 5 5 5"
                              fill="none"
                              stroke-width="2.5"
                              stroke-linecap="round" />
                    </svg>
                </span>

                <span>Чисто</span>
            </a>

            <!-- Заголовок -->
            <h1 class="welcome-title">
                Чисте авто<br />
                за кілька хвилин.
            </h1>

            <!-- АВТОМОБІЛЬ -->
            <div class="car-illustration">

                <svg viewBox="0 0 560 340"
                     role="img"
                     aria-label="Автомобіль із піною">

                    <!-- Тінь -->
                    <ellipse class="car-shadow"
                             cx="280"
                             cy="315"
                             rx="240"
                             ry="10" />

                    <!-- Бульбашки навколо автомобіля -->
                    <g class="bubble">
                        <circle cx="60" cy="160" r="26" />
                        <circle cx="110" cy="83" r="13" />
                        <circle cx="415" cy="60" r="12" />
                        <circle cx="508" cy="125" r="34" />
                        <circle cx="475" cy="35" r="17" />
                    </g>


<!-- Піна позаду автомобіля -->
<g class="car-foam" transform="translate(0, -12)">
    <circle cx="185" cy="173" r="18" />
    <circle cx="205" cy="153" r="22" />
    <circle cx="230" cy="144" r="24" />
    <circle cx="260" cy="137" r="27" />
    <circle cx="289" cy="148" r="23" />
    <circle cx="315" cy="162" r="18" />
    <circle cx="246" cy="112" r="10" />
    <circle cx="299" cy="122" r="9" />
</g>


                    <!-- Кузов автомобіля -->
                    <path class="car-body"
                          d="M62 218
                             Q75 205 140 200
                             L172 164
                             Q205 126 259 126
                             H317
                             Q359 126 391 160
                             L434 202
                             Q478 208 497 222
                             Q511 232 511 253
                             V277
                             H49
                             V250
                             Q49 229 62 218Z" />

                    <!-- Ліве вікно -->
                    <path class="car-window"
                          d="M180 196
                             L204 167
                             Q224 146 258 146
                             H291
                             V196Z" />

                    <!-- Праве вікно -->
                    <path class="car-window"
                          d="M306 146
                             H317
                             Q349 146 374 172
                             L397 196
                             H306Z" />

                    <!-- Лінія дверей -->
                    <path class="car-detail"
                          d="M299 147V274" />

                    <!-- Ручка дверей -->
                    <path class="car-handle"
                          d="M321 215H342" />

                    <!-- Фара -->
                    <rect x="473"
                          y="225"
                          width="27"
                          height="9"
                          rx="4.5"
                          fill="#FFD66B" />

                    <!-- Ліве колесо -->
                    <circle class="car-wheel"
                            cx="149"
                            cy="277"
                            r="39" />

                    <circle class="car-wheel-center"
                            cx="149"
                            cy="277"
                            r="21" />

                    <!-- Праве колесо -->
                    <circle class="car-wheel"
                            cx="417"
                            cy="277"
                            r="39" />

                    <circle class="car-wheel-center"
                            cx="417"
                            cy="277"
                            r="21" />

                </svg>
            </div>

        </section>

        <!-- ПРАВА ПАНЕЛЬ -->
        <section class="login-panel">

            <!-- Перемикач теми -->
            <div class="theme-switch">

                <button type="button"
                        id="themeToggle"
                        class="theme-button"
                        aria-label="Змінити тему">

                    <!-- Світла тема -->
                    <span class="theme-option"
                          data-mode="light">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">

                            <circle cx="12" cy="12" r="4" />

                            <path d="M12 2v2M12 20v2M2 12h2M20 12h2
                                     M4.9 4.9l1.5 1.5
                                     M17.6 17.6l1.5 1.5
                                     M4.9 19.1l1.5-1.5
                                     M17.6 6.4l1.5-1.5" />
                        </svg>
                    </span>

                    <!-- Темна тема -->
                    <span class="theme-option"
                          data-mode="dark">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4
                                     8.5 8.5 0 1 0 20 15.2Z" />
                        </svg>
                    </span>

                </button>
            </div>

            <!-- КАРТКА РЕЄСТРАЦІЇ -->
            <div class="auth-card register-card">

                <h2>Реєстрація</h2>

                <form asp-controller="Account"
                      asp-action="Register"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary"></div>

                    <!-- Ім'я та прізвище -->
                    <div class="name-row">

                        <div class="form-group">

                            <label asp-for="FirstName">
                                Ім'я
                            </label>

                            <input asp-for="FirstName"
                                   class="form-input"
                                   placeholder="Ім'я"
                                   autocomplete="given-name" />

                            <span asp-validation-for="FirstName"
                                  class="field-error"></span>
                        </div>

                        <div class="form-group">

                            <label asp-for="LastName">
                                Прізвище
                            </label>

                            <input asp-for="LastName"
                                   class="form-input"
                                   placeholder="Прізвище"
                                   autocomplete="family-name" />

                            <span asp-validation-for="LastName"
                                  class="field-error"></span>
                        </div>

                    </div>

                    <!-- Email -->
                    <div class="form-group">

                        <label asp-for="Email">
                            Email
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-input"
                               placeholder="name@example.com"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="field-error"></span>
                    </div>

                    <!-- Телефон -->
                    <div class="form-group">

                        <label asp-for="Phone">
                            Телефон
                        </label>

                        <input asp-for="Phone"
                               type="tel"
                               class="form-input"
                               placeholder="+380"
                               autocomplete="tel" />

                        <span asp-validation-for="Phone"
                              class="field-error"></span>
                    </div>

                    <!-- Пароль -->
                    <div class="form-group">

                        <label asp-for="Password">
                            Пароль
                        </label>

                        <div class="password-wrapper">

                            <input asp-for="Password"
                                   type="password"
                                   class="form-input"
                                   placeholder="Введіть пароль"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    aria-label="Показати пароль">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <path d="M2 12s4-7 10-7 10 7 10 7
                                             -4 7-10 7S2 12 2 12Z" />

                                    <circle cx="12"
                                            cy="12"
                                            r="3" />

                                    <path class="eye-slash"
                                          d="M3 3l18 18" />
                                </svg>
                            </button>
                        </div>

                        <span asp-validation-for="Password"
                              class="field-error"></span>
                    </div>

                    <!-- Підтвердження пароля -->
                    <div class="form-group">

                        <label asp-for="ConfirmPassword">
                            Підтвердження пароля
                        </label>

                        <div class="password-wrapper">

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-input"
                                   placeholder="Повторіть пароль"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    aria-label="Показати пароль">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <path d="M2 12s4-7 10-7 10 7 10 7
                                             -4 7-10 7S2 12 2 12Z" />

                                    <circle cx="12"
                                            cy="12"
                                            r="3" />

                                    <path class="eye-slash"
                                          d="M3 3l18 18" />
                                </svg>
                            </button>
                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="field-error"></span>
                    </div>

                    <!-- Кнопка реєстрації -->
                    <button type="submit"
                            class="login-button">
                        Зареєструватися
                    </button>

                </form>

                <!-- Посилання на вхід -->
                <p class="register-link">
                    Уже є акаунт?

                    <a asp-controller="Account"
                       asp-action="Login">
                        Увійти
                    </a>
                </p>

            </div>

        </section>
    </main>

    <script>
        // Показати або приховати пароль
        document.querySelectorAll(".password-toggle")
            .forEach(button => {

                button.addEventListener("click", () => {

                    const input =
                        button.parentElement.querySelector("input");

                    const visible = input.type === "text";

                    input.type = visible ? "password" : "text";

                    button.classList.toggle("visible", !visible);

                    button.setAttribute(
                        "aria-label",
                        visible
                            ? "Показати пароль"
                            : "Приховати пароль"
                    );
                });
            });

        // Перемикання теми
        document.getElementById("themeToggle")
            .addEventListener("click", () => {

                const current =
                    document.documentElement.dataset.theme;

                const next =
                    current === "dark" ? "light" : "dark";

                document.documentElement.dataset.theme = next;

                localStorage.setItem("carwash-theme", next);
            });
    </script>
</body>
</html>
