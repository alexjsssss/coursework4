
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Чисто</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/payment-refresh.css"
          asp-append-version="true" />

    <script>
        document.documentElement.dataset.theme =
            localStorage.getItem("carwash-theme") === "dark"
                ? "dark" : "light";
    </script>
</head>

<body class="payment-layout">

    <header class="payment-new-topbar">
        <a asp-controller="Client"
           asp-action="Index"
           class="payment-new-brand">

            <span class="payment-new-brand-icon">
                <svg viewBox="0 0 32 40" aria-hidden="true">
                    <path class="payment-new-drop"
                          d="M16 2C12 9 4 18 4 25a12 12 0 0 0 24 0C28 18 20 9 16 2Z" />
                    <path class="payment-new-drop-detail"
                          d="M11 27c0 3 2 5 5 5"
                          fill="none"
                          stroke-width="2.5"
                          stroke-linecap="round" />
                </svg>
            </span>

            <strong>Чисто</strong>
        </a>

        <button type="button"
                class="payment-new-theme"
                id="paymentThemeToggle"
                aria-label="Змінити тему">

            <span class="payment-theme-option" data-mode="light">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.5 1.5M17.6 17.6l1.5 1.5M4.9 19.1l1.5-1.5M17.6 6.4l1.5-1.5" />
                </svg>
            </span>

            <span class="payment-theme-option" data-mode="dark">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z" />
                </svg>
            </span>
        </button>
    </header>

    <main class="payment-new-main">
        @RenderBody()
    </main>

    <script>
        (() => {
            const toggle = document.getElementById("paymentThemeToggle");

            function updateTheme(theme) {
                document.documentElement.dataset.theme = theme;
                localStorage.setItem("carwash-theme", theme);

                toggle.setAttribute(
                    "aria-label",
                    theme === "dark"
                        ? "Увімкнути світлу тему"
                        : "Увімкнути темну тему"
                );
            }

            updateTheme(document.documentElement.dataset.theme);

            toggle.addEventListener("click", () => {
                updateTheme(
                    document.documentElement.dataset.theme === "dark"
                        ? "light" : "dark"
                );
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
