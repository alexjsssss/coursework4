@model string

@{
    var icon = (Model ?? "").Trim().ToLowerInvariant();

    var lucideIcon = icon switch
    {
        "prewash" => "spray-can",
        "water" => "droplets",
        "foam" => "cloud",
        "osmosis" => "waves",
        "wax" => "sparkles",
        "sparkles" => "star",
        "brush" => "brush",
        "shield" => "shield-check",
        "droplet" => "droplet",

        "spray-can" => "spray-can",
        "droplets" => "droplets",
        "cloud" => "cloud",
        "waves" => "waves",
        "shield-check" => "shield-check",

        _ => "droplet"
    };
}

<i data-lucide="@lucideIcon"></i>