
@{
    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var name = User.Identity?.Name ?? "Адміністратор";

    var initials = string.Concat(
        name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0]))
    );

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "А";
    }
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] — Чисто</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    <script>
        document.documentElement.dataset.theme =
            localStorage.getItem("carwash-theme") === "dark"
                ? "dark" : "light";
    </script>
</head>

<body class="client-layout admin-layout">

    <!-- БІЧНА ПАНЕЛЬ -->
    <aside class="sidebar">

        <a asp-controller="Admin"
           asp-action="Index"
           class="brand">

            <span class="brand-icon">
                <svg viewBox="0 0 32 40"
                     aria-hidden="true">
                    <path class="brand-drop"
                          d="M16 2C12 9 4 18 4 25a12 12 0 0 0 24 0C28 18 20 9 16 2Z" />

                    <path class="brand-drop-detail"
                          d="M11 27c0 3 2 5 5 5"
                          fill="none"
                          stroke-width="2.5"
                          stroke-linecap="round" />
                </svg>
            </span>

            <span class="brand-name">Чисто</span>
        </a>

        <!-- МЕНЮ -->
        <nav class="sidebar-nav"
             aria-label="Меню адміністратора">

            <a asp-controller="Admin"
               asp-action="Index"
               class="sidebar-link @(currentAction == "Index" ? "active" : "")"
               aria-current="@(currentAction == "Index" ? "page" : null)">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <rect x="3" y="3"
                          width="7" height="7" rx="1.5" />
                    <rect x="14" y="3"
                          width="7" height="7" rx="1.5" />
                    <rect x="3" y="14"
                          width="7" height="7" rx="1.5" />
                    <rect x="14" y="14"
                          width="7" height="7" rx="1.5" />
                </svg>

                <span>Головна</span>
            </a>

            <a asp-controller="Admin"
               asp-action="Orders"
               class="sidebar-link @(currentAction == "Orders" ? "active" : "")"
               aria-current="@(currentAction == "Orders" ? "page" : null)">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <rect x="4" y="4"
                          width="16" height="17" rx="2" />
                    <path d="M8 9h8M8 13h8M8 17h5" />
                </svg>

                <span>Замовлення</span>
            </a>

            <a asp-controller="Admin"
               asp-action="Services"
               class="sidebar-link @(currentAction == "Services" ? "active" : "")"
               aria-current="@(currentAction == "Services" ? "page" : null)">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M12 3c-2.5 3.5-6 7.5-6 11a6 6 0 0 0 12 0c0-3.5-3.5-7.5-6-11Z" />
                    <path d="M9 15a3 3 0 0 0 3 3" />
                </svg>

                <span>Послуги та бокси</span>
            </a>

        </nav>

        <!-- ВИХІД -->
        <div class="sidebar-bottom">
            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="logout-button">

                    <svg viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M10 17l5-5-5-5" />
                        <path d="M15 12H3" />
                        <path d="M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7" />
                    </svg>

                    <span>Вийти</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- ОСНОВНА ОБЛАСТЬ -->
    <div class="main-area">

        <header class="topbar">
            <div class="topbar-actions">

                <!-- ТЕМА -->
                <button type="button"
                        class="theme-button"
                        id="themeToggle"
                        aria-label="Змінити тему">

                    <span class="theme-option"
                          data-mode="light">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.5 1.5M17.6 17.6l1.5 1.5M4.9 19.1l1.5-1.5M17.6 6.4l1.5-1.5" />
                        </svg>
                    </span>

                    <span class="theme-option"
                          data-mode="dark">
                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z" />
                        </svg>
                    </span>
                </button>

                <!-- АДМІНІСТРАТОР -->
                <div class="account-info">
                    <div class="account-avatar">
                        @initials
                    </div>

                    <div class="account-details">
                        <strong>@name</strong>
                        <small>Адміністратор</small>
                    </div>
                </div>

            </div>
        </header>

        <main class="page-content admin-page-content">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (() => {
            const toggle = document.getElementById("themeToggle");

            if (!toggle) return;

            function updateTheme(theme) {
                document.documentElement.dataset.theme = theme;
                localStorage.setItem("carwash-theme", theme);

                toggle.setAttribute(
                    "aria-label",
                    theme === "dark"
                        ? "Увімкнути світлу тему"
                        : "Увімкнути темну тему"
                );
            }

            updateTheme(document.documentElement.dataset.theme);

            toggle.addEventListener("click", () => {
                updateTheme(
                    document.documentElement.dataset.theme === "dark"
                        ? "light"
                        : "dark"
                );
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
